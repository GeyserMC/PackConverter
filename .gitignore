### Eclipse ###
.metadata
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.recommenders

# External tool builders
.externalToolBuilders/

# sbteclipse plugin
.target

# Java
*.class
*.log
*.hprof

# IDE
.idea/*
!.idea/codeStyles
!.idea/runConfigurations
*.iml
*.ipr
*.iws
out/

# Gradle
.gradle/
**/build/
!src/**/build/
.nb-gradle/
gradle-app.setting
.gradletasknamecache

# Generated archives and build products
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Gradle wrapper generated binary
# Keep gradle-wrapper.properties and gradlew tracked, but never track the generated wrapper JAR.
gradle/wrapper/gradle-wrapper.jar

# IntelliJ generated state
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/caches/
.idea/**/libraries
.idea/**/gradle.xml
.idea/**/httpRequests

# NetBeans
**/nbproject/private/
**/nbproject/Makefile-*
**/nbproject/Makefile-*.bash

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/

# Test/build fixtures generated locally
test/
